Description: Fix parallel FTBFS
 This patch is needed for version 16.1.3, but can probably be dropped in
 subsequent releases, since upstream has refactored its build system and
 has apparently taken care of parallelization issues
 (see e.g. commit cb3294fc7bec0505285c3318a18990371b3f32f2).
Author: Sébastien Villemot <sebastien@debian.org>
Bug-Debian: https://bugs.debian.org/949896
Last-Update: 2020-02-01
---
This patch header follows DEP-3: http://dep.debian.net/deps/dep3/
--- a/src/Makefile.in
+++ b/src/Makefile.in
@@ -117,8 +117,11 @@ $(DPP): $(srcdir)/c/dpp.c $(srcdir)/c/sy
 		-o $@ $<; \
 	fi
 
-$(HFILES):
+$(HFILES): hfiles-copied
+
+hfiles-copied:
 	cp -rf $(srcdir)/h/*.h $(srcdir)/h/impl $(HDIR)
+	touch hfiles-copied
 
 $(OFILES): $(DPP) c/ecl/external.h $(HFILES) $(srcdir)/c/* $(CFILES)
 
