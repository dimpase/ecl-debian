	and closure environments did not work. Example of failed code
	(funcall
	    (compile nil
	            '(lambda (a b c)
	               (labels ((%f6 (f6-1 f6-2) c))
	                 (multiple-value-call #'%f6 (values a c)))))
	    0 10 20)

